---
import MurphyAvatar from './MurphyAvatar.astro';
// Murphy is a local portfolio companion. No external chat service is required.
---
<div id="guide" class="guide">
  <section id="guide-bubble" class="bubble" role="dialog" aria-label="Murphy companion" hidden>
    <header class="companion-header"><div><span class="eyebrow">YOUR LITTLE SIDEKICK</span><h2>Meet Murphy <span class="online" aria-hidden="true"></span></h2></div><button id="guide-close" type="button" aria-label="Close Murphy">×</button></header>
    <div class="companion-intro"><span class="intro-icon" aria-hidden="true">✦</span><div><strong>A little company. A little curiosity.</strong><p>Explore Opi’s world with me, or stay and play.</p></div></div>
    <nav class="companion-tabs" aria-label="Companion views"><button type="button" data-tab="explore" aria-pressed="true">→ Explore</button><button type="button" data-tab="care" aria-pressed="false">♡ Pet care</button></nav>
    <div id="guide-body" class="bubble-body"></div>
    <footer class="companion-footer"><button id="guide-voice" type="button" aria-pressed="false">Voice off</button><button id="guide-reset" type="button">Reset position →</button></footer>
  </section>
  <button id="guide-bot" class="bot" type="button" data-mood="idle" aria-label="Open Murphy companion" aria-expanded="false" aria-controls="guide-bubble" aria-haspopup="dialog">
    <MurphyAvatar />
    <span class="bot-label">Murphy <span>✦</span></span>
  </button>
</div>
<style>
.guide{position:fixed;right:1.25rem;bottom:4.5rem;z-index:200}
.bot{position:relative;z-index:1;display:block;width:104px;border:0;background:none;padding:0;cursor:grab;touch-action:none;color:var(--text)}
.bot :global(svg){animation:bob 4s ease-in-out infinite;width:100%;display:block;filter:drop-shadow(0 8px 12px #0002)}
.bot-label{display:inline-flex;gap:12px;align-items:center;padding:5px 12px;border:1px solid var(--border);background:var(--surface);border-radius:30px;font:600 11px var(--font-body);box-shadow:var(--shadow-sm)}
.bot-label span{color:var(--accent)}
.guide.dragging .bot{cursor:grabbing}.guide.dragging .bot :global(svg){animation:none}
@keyframes bob{50%{transform:translateY(-5px)}}
.bubble{position:fixed;z-index:2;width:360px;max-width:calc(100vw - 24px);max-height:calc(100dvh - 32px);overflow:auto;overscroll-behavior:contain;border:1px solid var(--border);border-radius:24px;background:var(--surface);box-shadow:0 24px 80px #0003;color:var(--text);font:14px/1.55 var(--font-body)}
.bubble[hidden]{display:none}
.companion-header{display:flex;justify-content:space-between;align-items:center;padding:22px 22px 16px}
.eyebrow{font:600 9px var(--font-mono);letter-spacing:1.6px;color:var(--text-3)}
h2{margin:5px 0 0;font:600 24px var(--font-display);letter-spacing:-.8px}.online{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--accent);vertical-align:middle;margin-left:6px;box-shadow:0 0 0 4px var(--accent-soft)}
.bubble :global(button){font:inherit;color:inherit;cursor:pointer;border:1px solid var(--border);background:var(--surface-2);border-radius:10px;padding:9px 12px;min-height:40px}
.bubble :global(button:hover){border-color:var(--accent);background:var(--accent-soft)}
.companion-header button{font-size:22px;background:none;border:0}
.companion-intro{display:flex;gap:12px;padding:16px 20px;background:var(--accent-soft);border-block:1px solid var(--border)}
.intro-icon{font-size:28px;color:var(--accent)}.companion-intro strong{font-size:12px}.companion-intro p{margin:4px 0 0;font-size:11px;color:var(--text-2)}
.companion-tabs{display:flex;margin:16px 20px 0;padding:4px;gap:4px;background:var(--surface-2);border-radius:12px}.companion-tabs button{flex:1;background:none;border:0;font-size:12px}.companion-tabs button[aria-pressed=true]{background:var(--surface);box-shadow:var(--shadow-sm);color:var(--accent)}
.bubble-body{padding:18px 20px}.bubble-body :global(p){margin:0 0 12px}.bubble-body :global(h3){font:600 18px var(--font-display);margin:0 0 8px}.bubble :global(.muted){color:var(--text-2);font-size:12px}
.bubble :global(.actions){display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:12px 0}.bubble :global(.actions button){text-align:left;font-size:12px}.bubble :global(button.primary){background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.bubble :global(.answer){border:1px solid var(--border);background:var(--surface-2);border-radius:12px;padding:12px;font-size:12px;margin:12px 0;overflow-wrap:anywhere}.bubble :global(.ask){display:flex;gap:6px}.bubble :global(.ask input){min-width:0;flex:1;border:1px solid var(--border);border-radius:10px;background:var(--bg);color:var(--text);padding:10px;font:inherit;font-size:12px}.bubble :global(.ask button){font-size:12px}
.bubble :global(.stat){display:flex;justify-content:space-between;font-size:12px;margin-top:10px}.bubble :global(meter){display:block;width:100%;height:12px;accent-color:var(--accent)}
.bubble :global(.tour-progress){height:4px;background:var(--border);border-radius:10px;margin-bottom:16px;overflow:hidden}.bubble :global(.tour-progress span){display:block;height:100%;background:var(--accent)}
.bubble :global(.tour-controls){display:flex;gap:6px;margin-top:16px}.bubble :global(.tour-controls button){font-size:12px}.companion-footer{display:flex;justify-content:space-between;border-top:1px solid var(--border);padding:10px 16px}.companion-footer button{font-size:10px;border:0;background:none;color:var(--text-2)}
:global(.guide-highlight){outline:2px solid var(--accent);outline-offset:6px;border-radius:12px}
@media(min-width:1100px){.guide{right:156px}}
@media(max-width:640px){.bot{width:82px}.guide{right:12px;bottom:70px}.bubble{max-height:calc(100dvh - 24px)}}
@media(prefers-reduced-motion:reduce){.bot,.bot *{animation:none!important}}
@media print{.guide{display:none}}
</style>
<script>
  import { initMurphy } from '../scripts/murphy';
  initMurphy();
</script>
