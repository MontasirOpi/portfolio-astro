---
/* Floating guide mascot "Murphy": a cute anime-style girl who hovers over the
   whole site, can be dragged anywhere, guides visitors on a tour, and behaves
   a little like a pet — she has moods (happy, excited, angry, sad, love) with
   expressive anime faces, mood animations and her own voice clips.
   Voice clips are stored as base64 text in public/audio/murphy/*.b64 and
   decoded to audio at runtime — no API keys, no backend, no binary files. */
---
<div id="guide" class="guide" aria-label="Site guide">
  <div id="guide-bubble" class="bubble" hidden>
    <button class="voice-toggle" id="guide-voice" type="button" aria-label="Toggle voice narration" aria-pressed="true">🔊</button>
    <button class="bubble-close" id="guide-close" type="button" aria-label="Close guide">×</button>
    <div class="bubble-body" id="guide-body"></div>
  </div>
  <button id="guide-bot" class="bot" type="button" data-mood="idle" aria-label="Open site guide" aria-haspopup="dialog">
    <svg viewBox="0 0 140 172" role="img" aria-label="Murphy, the friendly guide">
      <ellipse cx="70" cy="162" rx="34" ry="8" class="m-shadow" />
      <!-- back hair -->
      <ellipse cx="70" cy="86" rx="46" ry="64" class="m-hair" />
      <path d="M44 44 C38 66 38 92 42 114" class="m-shine" />
      <!-- side locks -->
      <path d="M42 62 C36 92 38 120 46 138 C50 146 60 142 56 132 C50 114 50 90 52 68 Z" class="m-hair" />
      <path d="M98 62 C104 92 102 120 94 138 C90 146 80 142 84 132 C90 114 90 90 88 68 Z" class="m-hair" />
      <!-- waving hand -->
      <g class="m-hand">
        <circle cx="112" cy="108" r="10" class="m-skin" />
        <path d="M107 100 l-3 -8 M112 99 l0 -8.5 M117 100 l3 -8" class="m-finger" />
      </g>
      <!-- face -->
      <circle cx="70" cy="74" r="32" class="m-skin" />
      <!-- bangs -->
      <path d="M38 70 Q39 42 70 38 Q101 42 102 70 L95 54 L89 70 L81 50 L73 68 L65 48 L57 68 L49 52 L43 68 Z" class="m-hair" />
      <!-- ahoge -->
      <path d="M70 38 C70 28 78 26 83 20 C86 17 84 13 80 15" class="m-ahoge" />
      <!-- bow -->
      <g class="m-bow" transform="translate(102,42) rotate(18)">
        <path d="M0 0 L-17 -10 L-15 10 Z" class="m-bowwing" />
        <path d="M0 0 L17 -10 L15 10 Z" class="m-bowwing" />
        <path d="M-3 5 L-9 22 L0 19 Z" class="m-bowtail" />
        <path d="M3 5 L9 22 L0 19 Z" class="m-bowtail" />
        <circle cx="0" cy="0" r="5.5" class="m-bowknot" />
      </g>

      <!-- ============ FACES (one per mood) ============ -->
      <g class="m-face m-face-idle">
        <path d="M44 80 Q56 71 68 80" class="m-lashline" />
        <path d="M72 80 Q84 71 96 80" class="m-lashline" />
        <ellipse cx="56" cy="88" rx="10" ry="13" class="m-eyewhite" />
        <ellipse cx="84" cy="88" rx="10" ry="13" class="m-eyewhite" />
        <circle cx="56" cy="89" r="7" class="m-iris" />
        <circle cx="84" cy="89" r="7" class="m-iris" />
        <circle cx="56" cy="89" r="3.6" class="m-pupil" />
        <circle cx="84" cy="89" r="3.6" class="m-pupil" />
        <circle cx="53.5" cy="85.5" r="2.8" class="m-spark" />
        <circle cx="81.5" cy="85.5" r="2.8" class="m-spark" />
        <circle cx="58.5" cy="91.5" r="1.3" class="m-spark" />
        <circle cx="86.5" cy="91.5" r="1.3" class="m-spark" />
        <path d="M47 66 Q56 63 65 66" class="m-brow" />
        <path d="M75 66 Q84 63 93 66" class="m-brow" />
        <path d="M62 110 Q70 116 78 110" class="m-mouth" />
        <ellipse cx="46" cy="100" rx="6.5" ry="4" class="m-blush" opacity="0.5" />
        <ellipse cx="94" cy="100" rx="6.5" ry="4" class="m-blush" opacity="0.5" />
      </g>

      <g class="m-face m-face-happy">
        <path d="M46 90 Q56 80 66 90" class="m-happyearc" />
        <path d="M74 90 Q84 80 94 90" class="m-happyearc" />
        <path d="M47 63 Q56 60 65 63" class="m-brow" />
        <path d="M75 63 Q84 60 93 63" class="m-brow" />
        <path d="M60 106 Q70 122 80 106 Q70 111 60 106 Z" class="m-mouthopen" />
        <ellipse cx="70" cy="114" rx="4" ry="2.6" class="m-tongue" />
        <ellipse cx="46" cy="100" rx="6.5" ry="4" class="m-blush" opacity="0.75" />
        <ellipse cx="94" cy="100" rx="6.5" ry="4" class="m-blush" opacity="0.75" />
      </g>

      <g class="m-face m-face-excited">
        <path d="M44 78 Q56 69 68 78" class="m-lashline" />
        <path d="M72 78 Q84 69 96 78" class="m-lashline" />
        <ellipse cx="56" cy="88" rx="10.5" ry="15" class="m-eyewhite" />
        <ellipse cx="84" cy="88" rx="10.5" ry="15" class="m-eyewhite" />
        <circle cx="56" cy="89" r="7.5" class="m-iris" />
        <circle cx="84" cy="89" r="7.5" class="m-iris" />
        <circle cx="56" cy="89" r="4" class="m-pupil" />
        <circle cx="84" cy="89" r="4" class="m-pupil" />
        <circle cx="53" cy="85" r="3.2" class="m-spark" />
        <circle cx="81" cy="85" r="3.2" class="m-spark" />
        <path d="M40 70 l1.8 4.6 4.6 1.8 -4.6 1.8 -1.8 4.6 -1.8 -4.6 -4.6 -1.8 4.6 -1.8 Z" class="m-star" />
        <path d="M100 70 l1.8 4.6 4.6 1.8 -4.6 1.8 -1.8 4.6 -1.8 -4.6 -4.6 -1.8 4.6 -1.8 Z" class="m-star" />
        <path d="M47 61 Q56 58 65 61" class="m-brow" />
        <path d="M75 61 Q84 58 93 61" class="m-brow" />
        <path d="M58 104 Q70 128 82 104 Q70 110 58 104 Z" class="m-mouthopen" />
        <ellipse cx="70" cy="116" rx="5" ry="3.2" class="m-tongue" />
        <ellipse cx="46" cy="100" rx="6.5" ry="4" class="m-blush" opacity="0.8" />
        <ellipse cx="94" cy="100" rx="6.5" ry="4" class="m-blush" opacity="0.8" />
      </g>

      <g class="m-face m-face-angry">
        <path d="M46 64 L66 72" class="m-angrybrow" />
        <path d="M94 64 L74 72" class="m-angrybrow" />
        <ellipse cx="56" cy="90" rx="9" ry="7.5" class="m-eyewhite" />
        <ellipse cx="84" cy="90" rx="9" ry="7.5" class="m-eyewhite" />
        <circle cx="56" cy="91" r="5.5" class="m-iris" />
        <circle cx="84" cy="91" r="5.5" class="m-iris" />
        <circle cx="56" cy="91" r="3" class="m-pupil" />
        <circle cx="84" cy="91" r="3" class="m-pupil" />
        <path d="M47 83 Q56 81 65 84" class="m-lidline" />
        <path d="M75 84 Q84 81 93 83" class="m-lidline" />
        <path d="M62 114 Q70 108 78 114" class="m-frown" />
        <ellipse cx="46" cy="100" rx="6" ry="3.6" class="m-blush" opacity="0.3" />
        <ellipse cx="94" cy="100" rx="6" ry="3.6" class="m-blush" opacity="0.3" />
      </g>

      <g class="m-face m-face-sad">
        <path d="M47 66 L65 60" class="m-sadbrow" />
        <path d="M93 66 L75 60" class="m-sadbrow" />
        <ellipse cx="56" cy="90" rx="8.5" ry="11" class="m-eyewhite" />
        <ellipse cx="84" cy="90" rx="8.5" ry="11" class="m-eyewhite" />
        <circle cx="56" cy="94" r="5" class="m-iris" />
        <circle cx="84" cy="94" r="5" class="m-iris" />
        <circle cx="56" cy="94" r="2.8" class="m-pupil" />
        <circle cx="84" cy="94" r="2.8" class="m-pupil" />
        <circle cx="54" cy="91" r="1.6" class="m-spark" />
        <circle cx="82" cy="91" r="1.6" class="m-spark" />
        <path d="M64 114 Q70 110 76 114" class="m-frown" />
        <ellipse cx="46" cy="100" rx="6" ry="3.6" class="m-blush" opacity="0.3" />
        <ellipse cx="94" cy="100" rx="6" ry="3.6" class="m-blush" opacity="0.3" />
      </g>

      <g class="m-face m-face-love">
        <path d="M44 80 Q56 71 68 80" class="m-lashline" />
        <path d="M72 80 Q84 71 96 80" class="m-lashline" />
        <ellipse cx="56" cy="88" rx="10" ry="13" class="m-eyewhite" />
        <ellipse cx="84" cy="88" rx="10" ry="13" class="m-eyewhite" />
        <path d="M56 94 C50 88 51 82 56 85 C61 82 62 88 56 94 Z" class="m-heartpupil" />
        <path d="M84 94 C78 88 79 82 84 85 C89 82 90 88 84 94 Z" class="m-heartpupil" />
        <circle cx="53.5" cy="85.5" r="2" class="m-spark" />
        <circle cx="81.5" cy="85.5" r="2" class="m-spark" />
        <path d="M47 66 Q56 63 65 66" class="m-brow" />
        <path d="M75 66 Q84 63 93 66" class="m-brow" />
        <path d="M62 109 Q66 114 70 109 Q74 114 78 109" class="m-catmouth" />
        <ellipse cx="46" cy="100" rx="7.5" ry="4.5" class="m-blush" opacity="0.85" />
        <ellipse cx="94" cy="100" rx="7.5" ry="4.5" class="m-blush" opacity="0.85" />
      </g>

      <!-- ============ MOOD EXTRAS ============ -->
      <g class="m-extra m-anger" transform="translate(110,58)">
        <path d="M0 -11 L3 -3 L11 0 L3 3 L0 11 L-3 3 L-11 0 L-3 -3 Z" class="m-angermark" />
      </g>
      <g class="m-extra m-sweat" transform="translate(112,94)">
        <path d="M0 -9 C6 -1 7 5 0 9 C-7 5 -6 -1 0 -9 Z" class="m-sweatdrop" />
      </g>
      <g class="m-extra m-hearts">
        <path d="M0 5 C-7 -2 -4 -9 0 -5 C4 -9 7 -2 0 5 Z" class="m-heart h1" transform="translate(32,58)" />
        <path d="M0 5 C-7 -2 -4 -9 0 -5 C4 -9 7 -2 0 5 Z" class="m-heart h2" transform="translate(108,50) scale(0.8)" />
      </g>
    </svg>
  </button>
</div>
<style>
  .guide{position:fixed;right:1.25rem;bottom:5rem;z-index:200;touch-action:none;filter:drop-shadow(0 10px 18px rgba(0,0,0,0.18))}
  .guide.placed{right:auto;bottom:auto}
  .guide.dragging{filter:drop-shadow(0 16px 26px rgba(0,0,0,0.25))}
  .guide.dragging .bot{animation-play-state:paused}
  .bot{display:block;width:112px;height:auto;background:none;border:0;padding:0;cursor:grab;animation:bob 3.4s ease-in-out infinite;-webkit-tap-highlight-color:transparent}
  .bot:active{cursor:grabbing}
  .bot:focus-visible{outline:3px solid var(--accent);outline-offset:4px;border-radius:18px}
  @keyframes bob{0%,100%{transform:translateY(0) rotate(-1.5deg)}50%{transform:translateY(-9px) rotate(1.5deg)}}
  /* ---- mood animations (pet-like behaviour) ---- */
  .bot[data-mood="happy"]{animation:happyBounce 0.9s ease-in-out infinite}
  @keyframes happyBounce{0%,100%{transform:translateY(0)}30%{transform:translateY(-14px)}60%{transform:translateY(0)}80%{transform:translateY(-6px)}}
  .bot[data-mood="excited"]{animation:excitedBob 0.8s ease-in-out infinite}
  @keyframes excitedBob{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-12px) scale(1.04)}}
  .bot[data-mood="angry"]{animation:angryShake 0.45s ease-in-out infinite}
  @keyframes angryShake{0%,100%{transform:translateX(0) rotate(-1deg)}25%{transform:translateX(-4px) rotate(1deg)}75%{transform:translateX(4px) rotate(-1deg)}}
  .bot[data-mood="sad"]{animation:sadDroop 3s ease-in-out infinite}
  @keyframes sadDroop{0%,100%{transform:translateY(0)}50%{transform:translateY(5px)}}
  .bot[data-mood="love"]{animation:loveSway 2.2s ease-in-out infinite}
  @keyframes loveSway{0%,100%{transform:rotate(-3deg) translateY(0)}50%{transform:rotate(3deg) translateY(-6px)}}
  /* ---- faces: only the active mood's face shows ---- */
  .m-face{display:none}
  .bot[data-mood="idle"] .m-face-idle,.bot[data-mood="happy"] .m-face-happy,.bot[data-mood="excited"] .m-face-excited,.bot[data-mood="angry"] .m-face-angry,.bot[data-mood="sad"] .m-face-sad,.bot[data-mood="love"] .m-face-love{display:block}
  .m-extra{display:none}
  .bot[data-mood="angry"] .m-anger{display:block}
  .bot[data-mood="sad"] .m-sweat{display:block}
  .bot[data-mood="love"] .m-hearts{display:block}
  /* ---- art ---- */
  .m-shadow{fill:rgba(0,0,0,0.12)}
  .m-hair{fill:#5a3a26}
  .m-shine{stroke:#8a5f36;stroke-width:6;stroke-linecap:round;fill:none;opacity:0.45}
  .m-ahoge{stroke:#5a3a26;stroke-width:3.5;stroke-linecap:round;fill:none}
  .m-skin{fill:#ffe0c2}
  .m-finger{stroke:#eab68c;stroke-width:2.4;stroke-linecap:round;fill:none}
  .m-hand{transform-box:fill-box;transform-origin:50% 88%;animation:wave 3.2s ease-in-out infinite}
  @keyframes wave{0%,100%{transform:rotate(0deg)}12%{transform:rotate(-26deg)}24%{transform:rotate(12deg)}36%{transform:rotate(-18deg)}48%,100%{transform:rotate(0deg)}}
  .m-bowwing{fill:var(--accent)}
  .m-bowtail{fill:color-mix(in srgb, var(--accent) 70%, #1c2330)}
  .m-bowknot{fill:color-mix(in srgb, var(--accent) 70%, #1c2330)}
  .m-bow{transform-box:fill-box;transform-origin:center;animation:bowSway 3.4s ease-in-out infinite}
  @keyframes bowSway{0%,100%{transform:translate(102px,42px) rotate(18deg)}50%{transform:translate(102px,42px) rotate(10deg)}}
  .m-eyewhite{fill:#fff}
  .m-iris{fill:#9a6230}
  .m-pupil{fill:#2a1c10}
  .m-spark{fill:#fff}
  .m-star{fill:#fff;opacity:0.95}
  .m-heartpupil{fill:#ff5a7a}
  .m-lashline{stroke:#2a1c10;stroke-width:4.5;stroke-linecap:round;fill:none}
  .m-lidline{stroke:#2a1c10;stroke-width:3.5;stroke-linecap:round;fill:none}
  .m-happyearc{stroke:#2a1c10;stroke-width:4.5;stroke-linecap:round;fill:none}
  .m-brow{stroke:#5a3a26;stroke-width:2.5;stroke-linecap:round;fill:none}
  .m-angrybrow{stroke:#5a3a26;stroke-width:4;stroke-linecap:round;fill:none}
  .m-sadbrow{stroke:#5a3a26;stroke-width:3;stroke-linecap:round;fill:none}
  .m-mouth{stroke:#b05252;stroke-width:2.5;stroke-linecap:round;fill:none}
  .m-mouthopen{fill:#b05252}
  .m-tongue{fill:#f09797}
  .m-frown{stroke:#b05252;stroke-width:2.5;stroke-linecap:round;fill:none}
  .m-catmouth{stroke:#b05252;stroke-width:2.5;stroke-linecap:round;fill:none}
  .m-blush{fill:#ff9db1}
  .m-angermark{fill:#ff5252;stroke:#d32f2f;stroke-width:1}
  .m-anger{transform-box:fill-box;transform-origin:center;animation:angerPulse 0.6s ease-in-out infinite}
  @keyframes angerPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.25)}}
  .m-sweatdrop{fill:#8fd3ff;stroke:#5aa9e6;stroke-width:1}
  .m-sweat{transform-box:fill-box;transform-origin:center;animation:sweatWobble 1.6s ease-in-out infinite}
  @keyframes sweatWobble{0%,100%{transform:translate(112px,94px) rotate(-6deg)}50%{transform:translate(112px,94px) rotate(6deg)}}
  .m-heart{fill:#ff6b9d}
  .m-hearts .m-heart{transform-box:fill-box;animation:heartFloat 1.8s ease-in-out infinite}
  .m-hearts .m-heart.h2{animation-delay:0.6s}
  @keyframes heartFloat{0%{transform:translateY(0);opacity:0}25%{opacity:1}100%{transform:translateY(-26px);opacity:0}}
  /* Speech bubble */
  .bubble{position:absolute;bottom:calc(100% + 16px);left:50%;transform:translateX(-50%) translateY(6px);width:max-content;max-width:min(320px,86vw);background:var(--surface);border:1px solid var(--border);border-radius:16px;box-shadow:0 18px 44px -12px rgba(0,0,0,0.28);padding:2rem 1.1rem 1.05rem;opacity:0;pointer-events:none;transition:opacity 0.22s var(--ease),transform 0.22s var(--ease);color:var(--text)}
  .bubble.show{opacity:1;pointer-events:auto;transform:translateX(-50%) translateY(0)}
  .bubble::after{content:"";position:absolute;top:100%;left:50%;transform:translateX(-50%);border:9px solid transparent;border-top-color:var(--surface);filter:drop-shadow(0 2px 1px rgba(0,0,0,0.06))}
  /* Flipped below the mascot when there is no room above (e.g. tour near the top edge). */
  .bubble.below{bottom:auto;top:calc(100% + 16px)}
  .bubble.below::after{top:auto;bottom:100%;border-top-color:transparent;border-bottom-color:var(--surface);filter:drop-shadow(0 -2px 1px rgba(0,0,0,0.06))}
  .bubble[hidden]{display:none}
  .bubble-close{position:absolute;top:0.35rem;right:0.55rem;background:none;border:0;font-size:1.25rem;line-height:1;color:var(--text-3);cursor:pointer;padding:0.35rem;min-width:38px;min-height:38px}
  .bubble-close:hover{color:var(--text)}
  .voice-toggle{position:absolute;top:0.35rem;left:0.55rem;background:none;border:0;font-size:1.05rem;cursor:pointer;padding:0.35rem;min-width:38px;min-height:38px}
  .voice-toggle[aria-pressed="false"]{filter:grayscale(1);opacity:0.5}
  .bubble-body{font-size:0.9rem;line-height:1.55}
  .bubble-body p{margin:0 0 0.7rem}
  .bubble-body p:last-child{margin-bottom:0}
  .bubble-name{font-family:var(--font-display);font-weight:700}
  .bubble-actions{display:flex;flex-wrap:wrap;gap:0.45rem;margin-top:0.75rem}
  .bubble-actions button{font:inherit;font-size:0.82rem;font-weight:600;border:1px solid var(--border);background:var(--surface-2);color:var(--text);border-radius:999px;padding:0.5rem 0.9rem;cursor:pointer;min-height:38px;transition:border-color 0.2s var(--ease),transform 0.2s var(--ease)}
  .bubble-actions button:hover{border-color:var(--accent);transform:translateY(-1px)}
  .bubble-actions button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
  .mood-label{font-size:0.78rem;color:var(--text-3);margin:0.7rem 0 0.15rem!important}
  .mood-row{margin-top:0.3rem!important}
  .mood-row button{font-size:1.25rem;padding:0.35rem 0.55rem;min-width:44px;min-height:44px}
  .tour-nav{display:flex;align-items:center;justify-content:space-between;gap:0.5rem;margin-top:0.8rem}
  .tour-nav .step{font-family:var(--font-mono);font-size:0.72rem;color:var(--text-3)}
  .tour-nav .row{display:flex;gap:0.45rem}
  /* Section highlight while touring */
  :global(.guide-highlight){outline:2px dashed var(--accent)!important;outline-offset:10px;border-radius:8px;animation:guidePulse 1.6s ease-in-out infinite}
  @keyframes guidePulse{0%,100%{outline-color:var(--accent)}50%{outline-color:color-mix(in srgb, var(--accent) 30%, transparent)}}
  @media (max-width:640px){
    .guide{right:0.9rem;bottom:4.5rem}
    .bot{width:84px}
  }
  /* Desktop has a 136px fixed side rail at the right edge — keep the mascot clear of it. */
  @media (min-width:1100px){
    .guide{right:calc(136px + 1.25rem)}
  }
  @media (prefers-reduced-motion: reduce){
    .bot,.m-hand,.m-bow,.m-anger,.m-sweat,.m-hearts .m-heart,:global(.guide-highlight){animation:none!important}
    .bubble{transition:none}
  }
  @media print{.guide{display:none}}
</style>
<script>
  (() => {
    const guide = document.getElementById('guide');
    const bot = document.getElementById('guide-bot');
    const bubble = document.getElementById('guide-bubble');
    const body = document.getElementById('guide-body');
    const closeBtn = document.getElementById('guide-close');
    const voiceBtn = document.getElementById('guide-voice');
    if (!guide || !bot || !bubble || !body) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GW = () => guide.offsetWidth, GH = () => guide.offsetHeight;

    /* ---------- voice clips (pre-generated neural voice, Aria) ----------
       Clips are stored as base64 text (public/audio/murphy/*.b64) so they can
       live in the repo; decoded to audio at runtime. */
    const voice = { on: true };
    try { voice.on = localStorage.getItem('murphy-voice') !== 'off'; } catch (e) {}
    let clip = null, playToken = 0;
    const clipCache = {};
    const stopClip = () => { playToken++; if (clip) { try { clip.pause(); } catch (e) {} clip = null; } };
    const clipUrl = async (name) => {
      if (!clipCache[name]) {
        const res = await fetch('audio/murphy/' + name + '.b64');
        const bin = atob((await res.text()).replace(/\s+/g, ''));
        const bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        clipCache[name] = URL.createObjectURL(new Blob([bytes], { type: 'audio/mpeg' }));
      }
      return clipCache[name];
    };
    const playClip = async (name) => {
      const t = ++playToken;
      stopClip(); playToken = t; // stopClip bumped the token; restore ours
      if (!voice.on) return;
      try {
        const url = await clipUrl(name);
        if (t !== playToken || !voice.on) return;
        clip = new Audio(url);
        clip.play().catch(() => { clip = null; });
      } catch (e) { clip = null; }
    };
    const setVoice = (on) => {
      voice.on = on;
      try { localStorage.setItem('murphy-voice', on ? 'on' : 'off'); } catch (e) {}
      if (voiceBtn) { voiceBtn.setAttribute('aria-pressed', on ? 'true' : 'false'); voiceBtn.textContent = on ? '🔊' : '🔇'; }
      if (!on) stopClip();
      else if (tour.i >= 0) playClip('s' + tour.i);
    };
    voiceBtn?.addEventListener('click', (e) => { e.stopPropagation(); setVoice(!voice.on); });
    // Sync the toggle UI without speaking (tour is declared further below).
    if (voiceBtn) { voiceBtn.setAttribute('aria-pressed', voice.on ? 'true' : 'false'); voiceBtn.textContent = voice.on ? '🔊' : '🔇'; }

    /* ---------- moods: Murphy behaves a little like a pet ---------- */
    const MOOD_CLIPS = { happy: 'happy', excited: 'excited', angry: 'angry', sad: 'sad', love: 'love' };
    let moodTimer = null;
    const setMood = (m, quiet) => {
      bot.dataset.mood = m;
      clearTimeout(moodTimer);
      if (!quiet && MOOD_CLIPS[m]) playClip(MOOD_CLIPS[m]);
      if (m !== 'idle') moodTimer = setTimeout(() => { bot.dataset.mood = 'idle'; }, 6000);
    };

    /* ---------- draggable anywhere ---------- */
    let drag = null;
    const clamp = (x, y) => {
      const rail = window.innerWidth >= 1100 ? 144 : 8; // keep clear of the desktop side rail
      return {
        x: Math.min(Math.max(x, 8), window.innerWidth - GW() - rail),
        y: Math.min(Math.max(y, 8), window.innerHeight - GH() - 8),
      };
    };
    const place = (x, y, animate = true) => {
      const c = clamp(x, y);
      guide.classList.add('placed');
      guide.style.transition = animate && !reduced ? 'left 0.45s var(--ease), top 0.45s var(--ease)' : 'none';
      guide.style.left = c.x + 'px';
      guide.style.top = c.y + 'px';
    };
    const resetPos = () => {
      guide.classList.remove('placed');
      guide.style.left = ''; guide.style.top = ''; guide.style.transition = '';
    };
    bot.addEventListener('pointerdown', (e) => {
      const r = guide.getBoundingClientRect();
      drag = { dx: e.clientX - r.left, dy: e.clientY - r.top, moved: false, sx: e.clientX, sy: e.clientY };
      guide.classList.add('dragging');
      guide.style.transition = 'none';
      bot.setPointerCapture(e.pointerId);
    });
    bot.addEventListener('pointermove', (e) => {
      if (!drag) return;
      if (Math.hypot(e.clientX - drag.sx, e.clientY - drag.sy) > 7) drag.moved = true;
      if (drag.moved) place(e.clientX - drag.dx, e.clientY - drag.dy, false);
    });
    const endDrag = () => { drag = null; guide.classList.remove('dragging'); };
    bot.addEventListener('pointerup', (e) => {
      const wasDrag = drag && drag.moved;
      endDrag();
      if (wasDrag) setMood('happy', true); // she likes being carried around
      else toggleBubble();
    });
    bot.addEventListener('pointercancel', endDrag);

    /* ---------- bubble content ---------- */
    const esc = (s) => s.replace(/</g, '&lt;');
    /* Keep the bubble inside the viewport: flip below the mascot when there is no room above. */
    const fitBubble = () => {
      bubble.classList.remove('below');
      let r = bubble.getBoundingClientRect();
      if (r.top < 8) {
        bubble.classList.add('below');
        r = bubble.getBoundingClientRect();
        if (r.bottom > window.innerHeight - 8) bubble.classList.remove('below');
      }
    };
    const showBubble = (html) => { body.innerHTML = html; bubble.hidden = false; requestAnimationFrame(() => { bubble.classList.add('show'); fitBubble(); }); wireActions(); };
    const hideBubble = () => { stopClip(); bubble.classList.remove('show'); setTimeout(() => { bubble.hidden = true; }, 240); };
    const toggleBubble = () => {
      if (!bubble.hidden && bubble.classList.contains('show')) { hideBubble(); return; }
      if (tour.i >= 0) { showBubble(tourHtml()); playClip('s' + tour.i); return; }
      showBubble(menuHtml());
      playClip('menu');
    };
    const menuHtml = () => `
      <p><span class="bubble-name">Hi, I'm Murphy!</span> 💁‍♀️<br>Opi's friendly guide. I can show you around the whole site.</p>
      <div class="bubble-actions">
        <button type="button" class="primary" data-act="tour">✨ Take the tour</button>
        <button type="button" data-act="goto" data-to="#projects">📂 Projects</button>
        <button type="button" data-act="goto" data-to="#contact">💬 Contact</button>
        <button type="button" data-act="hide">Maybe later</button>
      </div>
      <p class="mood-label">Make Murphy feel:</p>
      <div class="bubble-actions mood-row">
        <button type="button" data-act="mood" data-mood="happy" aria-label="Happy">😊</button>
        <button type="button" data-act="mood" data-mood="excited" aria-label="Excited">🤩</button>
        <button type="button" data-act="mood" data-mood="angry" aria-label="Angry">😠</button>
        <button type="button" data-act="mood" data-mood="sad" aria-label="Sad">😢</button>
        <button type="button" data-act="mood" data-mood="love" aria-label="Love">😍</button>
        <button type="button" data-act="mood" data-mood="idle" aria-label="Calm">😌</button>
      </div>`;
    const tourHtml = () => {
      const s = TOUR[tour.i];
      return `
      <p><span class="bubble-name">${esc(s.title)}</span><br>${esc(s.text)}</p>
      <div class="tour-nav">
        <span class="step">${tour.i + 1} / ${TOUR.length}</span>
        <span class="row">
          ${tour.i > 0 ? '<button type="button" data-act="back">← Back</button>' : ''}
          <button type="button" class="primary" data-act="next">${tour.i === TOUR.length - 1 ? 'Finish 🎉' : 'Next →'}</button>
          <button type="button" data-act="skip">Skip</button>
        </span>
      </div>`;
    };
    const wireActions = () => {
      body.querySelectorAll('[data-act]').forEach((b) => {
        b.addEventListener('click', () => {
          const act = b.getAttribute('data-act');
          if (act === 'tour') startTour();
          else if (act === 'goto') { endTour(true); scrollToSel(b.getAttribute('data-to')); hideBubble(); }
          else if (act === 'hide') hideBubble();
          else if (act === 'next') stepTour(tour.i + 1);
          else if (act === 'back') stepTour(tour.i - 1);
          else if (act === 'skip') { endTour(); hideBubble(); resetPos(); }
          else if (act === 'mood') setMood(b.getAttribute('data-mood'));
        });
      });
    };
    closeBtn?.addEventListener('click', () => { if (tour.i >= 0) { endTour(); resetPos(); } hideBubble(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !bubble.hidden) { if (tour.i >= 0) { endTour(); resetPos(); } hideBubble(); }
    });

    /* ---------- guided tour ---------- */
    const TOUR = [
      { sel: '#top', title: 'Welcome! 👋', text: 'This is Fahim Montasir Opi — Flutter developer and agentic AI developer from Dhaka, building production mobile apps.' },
      { sel: '#about', title: 'About Opi', text: 'A quick intro: clean-architecture Flutter apps on the Play Store and App Store, plus AI agents and Firebase backends.' },
      { sel: '#skills', title: 'Skills 🛠️', text: 'Tap any group to expand it — 62 skills across mobile, AI, backend, databases, DevOps and travel tech.' },
      { sel: '#ai', title: 'Agentic AI 🤖', text: 'My favourite part! Opi designs AI agents — planning loops, tool calling and multi-agent orchestration.' },
      { sel: '#experience', title: 'Experience 💼', text: 'Where Opi has worked — currently Associate Software Engineer at Innovate Solutions.' },
      { sel: '#projects', title: 'Projects 📂', text: '19 real projects with real links — production travel apps, on-device AI, open-source tools and 3D web toys.' },
      { sel: '#workflow', title: 'Workflow ⚙️', text: 'How Opi ships: requirements, reusable components, Firebase backends, AI-assisted delivery, testing and polish.' },
      { sel: '#contact', title: "Say hello! 💬", text: "That's the whole tour! You'll find Opi's email, GitHub and LinkedIn here. Thanks for visiting!" },
    ];
    const tour = { i: -1 };
    const scrollToSel = (sel) => {
      const el = document.querySelector(sel);
      if (el) el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' });
      return el;
    };
    const highlight = (el) => {
      document.querySelectorAll('.guide-highlight').forEach((n) => n.classList.remove('guide-highlight'));
      if (el) el.classList.add('guide-highlight');
    };
    const placeNear = (el) => {
      const r = el.getBoundingClientRect();
      // Keep the narration bubble (max 320px wide, centered on the mascot) clear of the desktop side rail too.
      const rail = window.innerWidth >= 1100 ? 144 : 0;
      let x = Math.min(r.right - GW() - 16, window.innerWidth - rail - 170 - GW() / 2);
      place(x, r.top + 16);
    };
    function startTour() { setMood('happy', true); stepTour(0); }
    function stepTour(i) {
      if (i >= TOUR.length) { endTour(); resetPos(); setMood('excited', true); showBubble('<p><span class="bubble-name">Tour complete! 🎉</span><br>Hope you enjoyed the walkthrough. Ping Opi from the contact section!</p><div class="bubble-actions"><button type="button" class="primary" data-act="hide">Done</button></div>'); playClip('done'); return; }
      tour.i = i;
      const s = TOUR[i];
      const el = scrollToSel(s.sel);
      highlight(el);
      if (el && !reduced) setTimeout(() => placeNear(el), 450); else if (el) placeNear(el);
      showBubble(tourHtml());
      playClip('s' + i);
    }
    function endTour(silent) { tour.i = -1; highlight(null); if (!silent) resetPos(); }

    window.addEventListener('resize', () => { if (guide.classList.contains('placed')) { const r = guide.getBoundingClientRect(); place(r.left, r.top, false); } });
  })();
</script>
