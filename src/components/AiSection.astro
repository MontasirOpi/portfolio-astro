---
import { AI_GROUPS } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section class="section" id="ai">
  <div class="container">
    <SectionHeading eyebrow="AI engineering" title="Expert in AI-assisted engineering" subtitle="AI is how I ship faster — for coding, integration, and review. Tools listed are those named in my source portfolio." />
    <div class="grid">{AI_GROUPS.map((g, idx) => <article><p class="num">{String(idx + 1).padStart(2, '0')}</p><h3>{g.title}</h3><p>{g.description}</p><ul>{g.items.map((i) => <li>{i}</li>)}</ul></article>)}</div>
    <p class="note">Tools and workflows I use daily — listed items are those from my source portfolio, not invented claims.</p>
  </div>
</section>
<style>
  .grid{display:grid;gap:1rem}
  @media(min-width:900px){.grid{grid-template-columns:1fr 1fr 1fr}}
  article{border-top:2px solid var(--text);padding-top:1.25rem}
  .num{font-family:var(--font-mono);color:var(--accent);font-weight:600;margin:0}
  h3{margin:0.5rem 0 0.6rem;font-family:var(--font-display)}
  article p{color:var(--text-2)}
  ul{margin:1rem 0 0;padding-left:1.15rem;color:var(--text-2)}
  li{margin-bottom:0.35rem}
  .note{margin-top:2rem;padding:1rem 1.15rem;background:var(--accent-soft);border:1px solid var(--border);border-radius:10px;color:var(--text-2);font-size:0.92rem}
</style>
