---
/**
 * Fixed right-edge section rail — original implementation for this portfolio.
 * Desktop only (>=1100px). Labels are this portfolio's own section names.
 * Active section via IntersectionObserver; scroll progress via rAF-throttled listener.
 * Hover behaviour (original code): hovering a label or the ruler/arrow area
 * animates the arrow + preview dot to the hovered position, expands and
 * highlights the matching label, dims the other labels, and highlights the
 * nearest ruler tick. Clicking the ruler jumps to the nearest section.
 */
const items = [
  { id: 'about', label: 'ABOUT' },
  { id: 'skills', label: 'SKILLS' },
  { id: 'ai', label: 'AI' },
  { id: 'projects', label: 'PROJECTS' },
  { id: 'experience', label: 'EXPERIENCE' },
  { id: 'contact', label: 'CONTACT' },
];
const ticks = [0, 25, 50, 75, 100];
---
<aside class="side-nav" aria-label="Section navigation">
  <div class="brand" aria-hidden="true">OPI</div>
  <nav class="labels" aria-label="Jump to section">
    <ul>
      {items.map((item, i) => (
        <li><button type="button" class="label" data-nav-id={item.id} data-nav-index={i} aria-label={`Jump to ${item.label}`}>{item.label}</button></li>
      ))}
    </ul>
  </nav>
  <div class="ruler-wrap" id="sidenav-ruler-wrap">
    <div class="ruler" id="sidenav-ruler" role="presentation">
      <div class="ruler-line"></div>
      {ticks.map((tick) => (
        <div class="tick" data-tick={tick} style={`top:${tick}%`}><span class="tick-mark"></span><span class="tick-num">{tick}</span></div>
      ))}
      <div class="hover-ghost" id="sidenav-ghost" aria-hidden="true"></div>
      <div class="hover-arrow" id="sidenav-arrow" aria-hidden="true"></div>
      <div class="progress-dot" id="sidenav-dot"></div>
    </div>
    <div class="progress-label" id="sidenav-pct">0%</div>
  </div>
</aside>
<style>
  .side-nav { display: none; animation: sideFade 0.6s ease both; }
  @keyframes sideFade { from { opacity: 0.2; } to { opacity: 1; } }
  @media (min-width: 1100px) {
    .side-nav { display: flex; flex-direction: column; align-items: stretch; position: fixed; top: 64px; right: 0; bottom: 0; width: 136px; padding: 1rem 14px 1rem 10px; z-index: 40; background: var(--bg); border-left: 1px solid var(--border); }
    .brand { font-family: var(--font-display); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.22em; color: var(--text-3); text-align: right; }
    .labels { flex: 1; display: flex; align-items: center; justify-content: flex-end; }
    .labels ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; align-items: flex-end; width: 100%; }
    .labels li { width: 100%; text-align: right; }
    .label { position: relative; width: 100%; padding: 6px 0; background: none; border: 0; cursor: pointer; font-family: var(--font-display); font-size: 0.62rem; font-weight: 500; letter-spacing: 0.1em; color: var(--text-3); text-align: right; white-space: nowrap; transition: color 220ms var(--ease), font-size 220ms var(--ease), opacity 220ms var(--ease), letter-spacing 220ms var(--ease), transform 220ms var(--ease); transform-origin: right center; }
    .label::after { content: ""; position: absolute; right: 0; bottom: 2px; width: 0; height: 2px; background: var(--accent); border-radius: 2px; transition: width 220ms var(--ease); }
    /* Dim the rest while one label is hovered — the hovered one pops. */
    .labels:hover .label { opacity: 0.35; }
    .labels:hover .label:hover, .labels:hover .label:focus-visible, .labels:hover .label.hover-preview { opacity: 1; }
    .label:hover, .label:focus-visible, .label.hover-preview { color: var(--accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; transform: translateX(-4px); }
    .label:hover::after, .label:focus-visible::after, .label.hover-preview::after { width: 18px; }
    .label.passed { opacity: 0.6; }
    .label.active { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; color: var(--text); opacity: 1; }
    .label.active::after { width: 22px; }
    .label.active.hover-preview, .label.active:hover { color: var(--accent); font-size: 0.78rem; }

    .ruler-wrap { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; padding: 8px 6px; border-radius: 10px; transition: background 220ms var(--ease); cursor: pointer; }
    .ruler-wrap:hover, .ruler-wrap.hovering { background: var(--surface-2); }
    .ruler { position: relative; width: 40px; height: 190px; cursor: pointer; }
    .ruler-line { position: absolute; top: 0; bottom: 0; right: 8px; width: 1px; background: var(--border-strong); transition: background 220ms var(--ease), width 220ms var(--ease); }
    .ruler-wrap:hover .ruler-line, .ruler-wrap.hovering .ruler-line { background: var(--accent); width: 2px; }
    .tick { position: absolute; right: 0; display: flex; align-items: center; gap: 4px; transform: translateY(-50%); transition: transform 220ms var(--ease); }
    .tick-mark { width: 8px; height: 1px; background: var(--text-3); transition: width 220ms var(--ease), background 220ms var(--ease), height 220ms var(--ease); }
    .tick-num { font-family: var(--font-mono); font-size: 0.52rem; color: var(--text-3); line-height: 1; transition: color 220ms var(--ease), font-size 220ms var(--ease); }
    .tick.hover-preview .tick-mark { width: 18px; height: 2px; background: var(--accent); }
    .tick.hover-preview .tick-num { color: var(--accent); font-size: 0.62rem; }
    .progress-dot { position: absolute; right: 5px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); transform: translateY(-50%); transition: top 120ms linear, transform 220ms var(--ease), box-shadow 220ms var(--ease); top: 0%; z-index: 2; }
    .ruler-wrap:hover .progress-dot, .ruler-wrap.hovering .progress-dot { transform: translateY(-50%) scale(1.35); box-shadow: 0 0 0 4px var(--accent-soft), 0 0 12px var(--accent); }
    /* Hover arrow: left-pointing triangle that slides along the ruler. */
    .hover-arrow { position: absolute; right: 20px; top: 0%; width: 0; height: 0; border-top: 6px solid transparent; border-bottom: 6px solid transparent; border-right: 9px solid var(--accent); opacity: 0; transform: translateY(-50%) translateX(6px) scale(0.8); transition: top 180ms var(--ease), opacity 220ms var(--ease), transform 220ms var(--ease); z-index: 3; pointer-events: none; }
    .hover-arrow.visible { opacity: 1; transform: translateY(-50%) translateX(0) scale(1); }
    .ruler-wrap:hover .hover-arrow, .ruler-wrap.hovering .hover-arrow { filter: drop-shadow(0 0 6px var(--accent)); }
    /* Hollow preview ring that follows the hover position. */
    .hover-ghost { position: absolute; right: 4px; top: 0%; width: 12px; height: 12px; border: 1.5px solid var(--accent); border-radius: 50%; background: transparent; opacity: 0; transform: translateY(-50%) scale(0.7); transition: top 180ms var(--ease), opacity 220ms var(--ease), transform 220ms var(--ease); z-index: 1; pointer-events: none; }
    .hover-ghost.visible { opacity: 1; transform: translateY(-50%) scale(1); }
    .progress-label { font-family: var(--font-mono); font-size: 0.6rem; color: var(--text-2); min-width: 26px; text-align: right; transition: color 220ms var(--ease); }
    .ruler-wrap:hover .progress-label, .ruler-wrap.hovering .progress-label { color: var(--accent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .side-nav *, .side-nav *::after { transition: none !important; animation: none !important; }
  }
  @media print { .side-nav { display: none !important; } }
</style>
<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.side-nav .label'));
  const dot = document.getElementById('sidenav-dot');
  const pctLabel = document.getElementById('sidenav-pct');
  const ruler = document.getElementById('sidenav-ruler');
  const rulerWrap = document.getElementById('sidenav-ruler-wrap');
  const arrow = document.getElementById('sidenav-arrow');
  const ghost = document.getElementById('sidenav-ghost');
  const tickEls = Array.from(document.querySelectorAll<HTMLElement>('.side-nav .tick'));
  const ids = buttons.map((b) => b.dataset.navId || '');
  let activeId: string | null = null;
  let currentPct = 0;
  let hoverIdx: number | null = null;
  let hoverPct: number | null = null;

  function labelPct(i: number) {
    if (buttons.length <= 1) return 0;
    return (i / (buttons.length - 1)) * 100;
  }
  function nearestLabelIdx(pct: number) {
    let best = 0;
    let bestDist = Infinity;
    buttons.forEach((_, i) => {
      const d = Math.abs(labelPct(i) - pct);
      if (d < bestDist) { bestDist = d; best = i; }
    });
    return best;
  }
  function nearestTick(pct: number) {
    let best: HTMLElement | null = null;
    let bestDist = Infinity;
    for (const t of tickEls) {
      const v = Number(t.dataset.tick || '0');
      const d = Math.abs(v - pct);
      if (d < bestDist) { bestDist = d; best = t; }
    }
    return best;
  }
  function positionHoverUI(pct: number) {
    if (arrow) { arrow.style.top = pct + '%'; arrow.classList.add('visible'); }
    if (ghost) { ghost.style.top = pct + '%'; ghost.classList.add('visible'); }
  }
  function clearHoverUI() {
    hoverIdx = null;
    hoverPct = null;
    buttons.forEach((b) => b.classList.remove('hover-preview'));
    tickEls.forEach((t) => t.classList.remove('hover-preview'));
    rulerWrap?.classList.remove('hovering');
    // Arrow / ghost fall back to the real scroll position.
    if (arrow) { arrow.style.top = currentPct + '%'; arrow.classList.add('visible'); }
    if (ghost) ghost.classList.remove('visible');
  }
  function setHover(idx: number, pct: number) {
    hoverIdx = idx;
    hoverPct = pct;
    buttons.forEach((b, i) => b.classList.toggle('hover-preview', i === idx));
    const tick = nearestTick(pct);
    tickEls.forEach((t) => t.classList.toggle('hover-preview', t === tick));
    rulerWrap?.classList.add('hovering');
    positionHoverUI(pct);
  }
  function setActive(id: string | null) {
    activeId = id;
    const activeIdx = ids.indexOf(id || '');
    buttons.forEach((b, i) => {
      const isActive = b.dataset.navId === id;
      b.classList.toggle('active', isActive);
      b.classList.toggle('passed', activeIdx !== -1 && i < activeIdx);
      if (isActive) b.setAttribute('aria-current', 'true'); else b.removeAttribute('aria-current');
    });
  }
  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const pct = max <= 0 ? 0 : Math.min(100, Math.max(0, Math.round((window.scrollY / max) * 100)));
    currentPct = pct;
    if (dot) dot.style.top = pct + '%';
    if (pctLabel) pctLabel.textContent = pct + '%';
    // When not hovering, the arrow tracks the real scroll position.
    if (hoverPct === null && arrow) arrow.style.top = pct + '%';
    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) setActive('contact');
  }
  let ticking = false;
  const schedule = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => { ticking = false; updateProgress(); });
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  updateProgress();
  if (typeof IntersectionObserver !== 'undefined') {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) setActive(entry.target.id);
    }, { root: null, rootMargin: '-45% 0px -45% 0px', threshold: 0 });
    for (const id of ids) { const el = document.getElementById(id); if (el) observer.observe(el); }
  }
  // Hovering a label: highlight it + slide the arrow / ghost to its ruler position.
  buttons.forEach((b, i) => {
    b.addEventListener('mouseenter', () => setHover(i, labelPct(i)));
    b.addEventListener('focus', () => setHover(i, labelPct(i)));
    b.addEventListener('mouseleave', () => clearHoverUI());
    b.addEventListener('blur', () => clearHoverUI());
    b.addEventListener('click', () => {
      const id = b.dataset.navId;
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      setActive(id);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    });
  });
  // Hovering / moving over the ruler: arrow + ghost follow the pointer,
  // nearest label expands/highlights and nearest tick lights up.
  if (ruler) {
    ruler.addEventListener('mousemove', (e) => {
      const rect = ruler.getBoundingClientRect();
      if (rect.height === 0) return;
      const pct = Math.min(100, Math.max(0, ((e.clientY - rect.top) / rect.height) * 100));
      const idx = nearestLabelIdx(pct);
      setHover(idx, pct);
    });
    ruler.addEventListener('mouseleave', () => clearHoverUI());
    // Clicking the ruler jumps to the nearest section.
    ruler.addEventListener('click', (e) => {
      const rect = ruler.getBoundingClientRect();
      if (rect.height === 0) return;
      const pct = Math.min(100, Math.max(0, ((e.clientY - rect.top) / rect.height) * 100));
      const idx = nearestLabelIdx(pct);
      const id = ids[idx];
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      setActive(id);
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      el.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
    });
  }
  // Keep the arrow visible at the scroll position on load.
  if (arrow) { arrow.style.top = currentPct + '%'; arrow.classList.add('visible'); }
</script>
