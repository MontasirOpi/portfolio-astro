---
import { SKILL_GROUPS } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const iconUrl = (slug: string) => `https://cdn.simpleicons.org/${slug}`;
const initials = (label: string) =>
  label.replace(/[^A-Za-z0-9 ]/g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const total = SKILL_GROUPS.reduce((n, g) => n + g.items.length, 0);
---
<section class="section" id="skills">
  <div class="container">
    <SectionHeading eyebrow="Skills" title="What I work with" subtitle="Tap a group to see the skills inside." />
    <div class="skill-search" data-reveal>
      <Icon name="search" />
      <input id="skill-search" type="search" placeholder={`Search ${total} skills — try "flutter", "firebase", "ai"…`} aria-label="Search skills" autocomplete="off" />
      <span class="search-count" id="skill-count" aria-live="polite"></span>
    </div>
    <div class="groups" id="skill-groups" data-reveal>
      {SKILL_GROUPS.map((g, gi) => (
        <article class={`group${gi === 0 ? ' open' : ''}`} data-group style={`--ga:${g.accent}`}>
          <button class="group-head" type="button" aria-expanded={gi === 0 ? 'true' : 'false'} aria-controls={`skills-panel-${gi}`} id={`skills-head-${gi}`}>
            <span class="accent-bar" aria-hidden="true"></span>
            <span class="g-icon">
              {g.icon
                ? <img src={iconUrl(g.icon)} alt="" loading="lazy" width="22" height="22" />
                : <span class="mono" aria-hidden="true">OTA</span>}
            </span>
            <span class="g-text">
              <span class="g-title">{g.title}</span>
              <span class="g-sub" data-sub>{g.items.length} skills</span>
            </span>
            <span class="chev" aria-hidden="true"></span>
          </button>
          <div class="group-panel" id={`skills-panel-${gi}`} role="region" aria-labelledby={`skills-head-${gi}`}>
            <div class="panel-inner">
              <ul>
                {g.items.map((s) => (
                  <li data-label={s.label.toLowerCase()}>
                    {s.icon
                      ? <span class="logo"><img src={iconUrl(s.icon)} alt={s.label + ' logo'} loading="lazy" width="16" height="16" /></span>
                      : <span class="logo mono-sm" aria-hidden="true">{initials(s.label)}</span>}
                    <span>{s.label}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </div>
    <p class="no-results" id="skill-empty" hidden>No skills match your search — try another keyword.</p>
  </div>
</section>
<style>
  .skill-search{display:flex;align-items:center;gap:0.6rem;background:var(--surface-2);border:1px solid var(--border);border-radius:999px;padding:0.55rem 1.1rem;margin-bottom:1.25rem;max-width:560px;color:var(--text-3)}
  .skill-search:focus-within{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);color:var(--text)}
  .skill-search input{flex:1;min-width:0;background:none;border:0;outline:0;color:var(--text);font-size:0.92rem;font-family:inherit}
  .skill-search input::placeholder{color:var(--text-3)}
  .skill-search input::-webkit-search-cancel-button{cursor:pointer}
  .search-count{font-family:var(--font-mono);font-size:0.72rem;color:var(--text-3);white-space:nowrap}
  /* Simple accordion: one clean row per group, tap to expand. */
  .groups{display:flex;flex-direction:column;gap:0.55rem;max-width:820px}
  .group{border:1px solid var(--border);border-radius:14px;background:var(--surface);overflow:hidden;transition:border-color 0.25s var(--ease)}
  .group.open{border-color:color-mix(in srgb, var(--ga) 45%, var(--border))}
  .group[hidden]{display:none}
  .group-head{display:flex;align-items:center;gap:0.85rem;width:100%;min-height:60px;padding:0.7rem 1rem 0.7rem 0;background:none;border:0;cursor:pointer;font:inherit;color:var(--text);text-align:left;-webkit-tap-highlight-color:transparent}
  .group-head:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
  .accent-bar{width:4px;align-self:stretch;border-radius:0 4px 4px 0;background:var(--ga);flex:none}
  .g-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:10px;background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--border);flex:none}
  .g-icon img{width:22px;height:22px}
  .g-icon .mono{font-family:var(--font-display);font-weight:700;font-size:0.68rem;color:var(--text);letter-spacing:0.05em}
  .g-text{display:flex;flex-direction:column;gap:0.1rem;flex:1;min-width:0}
  .g-title{font-family:var(--font-display);font-weight:600;font-size:1rem}
  .g-sub{font-family:var(--font-mono);font-size:0.72rem;color:var(--text-3)}
  .chev{flex:none;width:10px;height:10px;border-right:2px solid var(--text-3);border-bottom:2px solid var(--text-3);transform:rotate(45deg) translateY(-2px);transition:transform 0.25s var(--ease)}
  .group.open .chev{transform:rotate(225deg) translateY(-2px)}
  .group-panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows 0.3s var(--ease)}
  .group.open .group-panel{grid-template-rows:1fr}
  .panel-inner{overflow:hidden;min-height:0}
  .group-panel ul{list-style:none;margin:0;padding:0 1rem 1rem 4.7rem;display:flex;flex-wrap:wrap;gap:0.4rem}
  .group li{display:inline-flex;align-items:center;gap:0.45rem;border:1px solid var(--border);background:var(--surface-2);border-radius:999px;padding:0.28rem 0.8rem 0.28rem 0.28rem;font-size:0.82rem;color:var(--text-2)}
  .group li[hidden]{display:none}
  .logo{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:var(--surface);box-shadow:inset 0 0 0 1px var(--border);flex:none}
  .logo img{width:15px;height:15px}
  .logo.mono-sm{font-family:var(--font-mono);font-size:0.55rem;font-weight:700;color:var(--ga)}
  .no-results{margin:1.5rem 0 0;text-align:center;color:var(--text-3);font-size:0.9rem}
  .no-results[hidden]{display:none}
  @media (prefers-reduced-motion: reduce){
    .group,.group-panel,.chev{transition:none}
  }
</style>
<script>
  const input = document.getElementById('skill-search') as HTMLInputElement | null;
  const groups = Array.from(document.querySelectorAll<HTMLElement>('#skill-groups [data-group]')).map((el) => ({
    el,
    head: el.querySelector<HTMLButtonElement>('.group-head'),
    sub: el.querySelector('.g-sub'),
    total: el.querySelectorAll('li').length,
  }));
  const countEl = document.getElementById('skill-count');
  const emptyEl = document.getElementById('skill-empty');
  const totalSkills = groups.reduce((n, g) => n + g.total, 0);
  const renderCount = (n: number) => { if (countEl) countEl.textContent = `${n} / ${totalSkills}`; };
  const setOpen = (g: (typeof groups)[number], open: boolean) => {
    g.el.classList.toggle('open', open);
    g.head?.setAttribute('aria-expanded', open ? 'true' : 'false');
  };
  const closeOthers = (keep: (typeof groups)[number]) => groups.forEach((g) => { if (g !== keep) setOpen(g, false); });
  groups.forEach((g) => {
    g.head?.addEventListener('click', () => {
      const willOpen = !g.el.classList.contains('open');
      if (input && input.value.trim()) { setOpen(g, willOpen); return; } // while searching, toggle freely
      closeOthers(g);
      setOpen(g, willOpen);
    });
  });
  renderCount(totalSkills);
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    groups.forEach((g) => {
      let gShown = 0;
      g.el.querySelectorAll('li').forEach((li) => {
        const hit = !q || (li.dataset.label || '').includes(q);
        li.hidden = !hit;
        if (hit) { gShown++; shown++; }
      });
      g.el.hidden = gShown === 0;
      if (g.sub) g.sub.textContent = q ? `${gShown} of ${g.total} skills` : `${g.total} skills`;
      setOpen(g, q ? gShown > 0 : g === groups[0]);
    });
    if (emptyEl) emptyEl.hidden = shown !== 0;
    renderCount(shown);
  });
</script>
