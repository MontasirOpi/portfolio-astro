---
import { SKILL_GROUPS } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section class="section" id="skills">
  <div class="container">
    <SectionHeading eyebrow="Skills" title="What I work with" subtitle="Grouped by how I actually use them — no percentages, no inflated levels." />
    <div class="groups">{SKILL_GROUPS.map((g) => <article class="group"><h3>{g.title}</h3><ul>{g.items.map((i) => <li>{i}</li>)}</ul></article>)}</div>
  </div>
</section>
<style>
  .groups{display:grid;gap:1rem}
  @media(min-width:700px){.groups{grid-template-columns:1fr 1fr}}
  @media(min-width:1100px){.groups{grid-template-columns:1fr 1fr 1fr}}
  .group{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:1.35rem}
  .group h3{margin:0 0 0.9rem;font-family:var(--font-display);font-size:1.05rem}
  .group ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:0.4rem}
  .group li{border:1px solid var(--border);background:var(--surface-2);border-radius:999px;padding:0.28rem 0.6rem;font-size:0.84rem}
</style>
