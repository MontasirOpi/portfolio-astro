---
import { PROFILE } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
const p = PROFILE;
---
<section class="section" id="contact">
  <div class="container">
    <SectionHeading eyebrow="Contact" title="Let’s build something reliable together" subtitle="For recruiters, engineering teams, and collaborators — the fastest way to reach me is email." />
    <div class="grid">
      <div class="cta-box"><h3>Available for opportunities</h3><p>I am interested in Flutter and full-stack roles where AI-assisted delivery, Firebase backends, performance, and clean architecture matter.</p><div class="btns"><a class="btn btn-primary" href={`mailto:${p.email}`}>Email me <Icon name="arrow" /></a><a class="btn btn-ghost" href={p.cvUrl} target="_blank" rel="noopener">View CV</a></div></div>
      <ul class="details">
        <li><Icon name="mail" /><div><span>Email</span><a href={`mailto:${p.email}`}>{p.email} <em class="tag">primary</em></a><a class="alt" href={`mailto:${p.altEmail}`}>{p.altEmail}</a></div></li>
        <li><Icon name="phone" /><div><span>Phone</span><a href={p.phoneHref}>{p.phoneDisplay}</a></div></li>
        <li><Icon name="pin" /><div><span>Location</span><strong>{p.location}</strong></div></li>
        <li><Icon name="github" /><div><span>GitHub</span><a href={p.github} target="_blank" rel="noopener">github.com/MontasirOpi</a></div></li>
        <li><Icon name="linkedin" /><div><span>LinkedIn</span><a href={p.linkedin} target="_blank" rel="noopener">linkedin.com/in/montasir-opi</a></div></li>
      </ul>
    </div>
    <p class="note">No contact form here — email links open your mail app so messages actually reach me.</p>
  </div>
</section>
<style>
  .grid{display:grid;gap:1.5rem}
  @media(min-width:900px){.grid{grid-template-columns:1.1fr 0.9fr}}
  .cta-box{border:1px solid var(--border);background:var(--surface);border-radius:14px;padding:2rem}
  .cta-box h3{margin:0 0 0.6rem;font-family:var(--font-display);font-size:1.4rem}
  .cta-box p{color:var(--text-2)}
  .btns{display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.4rem}
  .details{list-style:none;margin:0;padding:0;display:grid;gap:0.9rem}
  .details li{display:flex;gap:0.9rem;align-items:flex-start;border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:1rem 1.15rem}
  .details div{display:grid}
  .details span{font-size:0.8rem;color:var(--text-3);text-transform:uppercase;letter-spacing:0.08em;font-family:var(--font-mono)}
  .details a{font-weight:600;text-decoration:none}
  .details a:hover{text-decoration:underline}
  .details a.alt{font-weight:500;font-size:0.88rem;color:var(--text-2)}
  .tag{font-style:normal;font-family:var(--font-mono);font-size:0.62rem;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;background:color-mix(in srgb, var(--accent) 14%, transparent);color:var(--accent);border-radius:999px;padding:0.12rem 0.45rem;margin-left:0.35rem;vertical-align:1px}
  .note{margin-top:1.25rem;color:var(--text-3);font-size:0.9rem}
</style>
