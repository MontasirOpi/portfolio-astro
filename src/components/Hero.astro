---
import { PROFILE } from '../data/portfolio';
import Icon from './Icon.astro';
const p = PROFILE;
---
<section class="hero" id="top">
  <div class="container hero-grid reveal">
    <div class="hero-text">
      <p class="eyebrow hero-anim">// Hello world, I&rsquo;m</p>
      <h1 class="display hero-anim hero-name"><span class="name-underline">{p.name}</span></h1>
      <p class="role hero-anim">Flutter Developer &middot; {p.title}</p>
      <p class="lede hero-anim">{p.heroIntro}</p>
      <div class="cta hero-anim"><a href="#projects" class="btn btn-primary">View Projects <Icon name="arrow" /></a><a href={p.cvUrl} target="_blank" rel="noopener" class="btn btn-ghost">View CV</a><a href="#contact" class="btn btn-ghost">Contact</a></div>
      <div class="socials hero-anim"><a href={p.github} target="_blank" rel="noopener" aria-label="GitHub profile"><Icon name="github" /> GitHub</a><a href={p.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile"><Icon name="linkedin" /> LinkedIn</a><span class="loc"><Icon name="pin" /> {p.location}</span></div>
      <div class="meta hero-anim"><span><strong>Focus</strong> Flutter &middot; AI-Assisted &middot; Firebase &middot; OTA</span><span><strong>Currently</strong> Associate Software Engineer</span></div>
    </div>
    <aside class="visual hero-anim hero-visual" aria-label="Profile photo">
      <div class="photo-wrap"><img src={p.profileImage} alt="Portrait of Fahim Montasir Opi" width="520" height="520" fetchpriority="high" /></div>
      <div class="card"><p class="card-label">Currently building</p><p class="card-title">Production Flutter apps</p><p class="card-sub">AI-assisted &middot; Firebase backends &middot; OTA as one specialty</p></div>
    </aside>
  </div>
</section>
<style>
  .hero{padding-block:3rem 3.5rem}
  @media(min-width:900px){.hero{padding-block:4.5rem 5rem}}
  .hero-grid{display:grid;gap:2.5rem;align-items:center}
  @media(min-width:900px){.hero-grid{grid-template-columns:1.15fr 0.85fr;gap:3rem}}
  .role{font-family:var(--font-display);font-size:clamp(1.2rem,2vw,1.5rem);color:var(--accent);font-weight:600;margin:0.9rem 0 1rem}
  .cta{display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.8rem}
  .socials{display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:1.6rem;font-size:0.92rem}
  .socials a{display:inline-flex;gap:0.45rem;align-items:center;text-decoration:none;font-weight:600}
  .socials a:hover{text-decoration:underline}
  .loc{display:inline-flex;gap:0.4rem;align-items:center;color:var(--text-2)}
  .meta{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--border);font-size:0.9rem;color:var(--text-2)}
  .visual{position:relative}
  .photo-wrap{border:1px solid var(--border);border-radius:16px;overflow:hidden;background:var(--surface-2);aspect-ratio:1/1;max-width:460px;margin-inline:auto}
  .photo-wrap img{width:100%;height:100%;object-fit:cover;display:block}
  .card{position:absolute;left:-6px;bottom:18px;background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:1rem 1.15rem;box-shadow:var(--shadow-md);max-width:280px}
  @media(max-width:640px){.card{position:static;margin-top:1rem;max-width:none}}
  .card-label{font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-3);margin:0 0 0.3rem}
  .card-title{font-weight:700;margin:0}
  .card-sub{margin:0.25rem 0 0;color:var(--text-2);font-size:0.88rem}
  /* Staggered hero entrance + name underline draw — fast, no parallax/blobs. */
  .hero-anim{animation:heroIn 0.5s var(--ease) both}
  .hero-text .hero-anim:nth-child(1){animation-delay:0ms}
  .hero-text .hero-anim:nth-child(2){animation-delay:70ms}
  .hero-text .hero-anim:nth-child(3){animation-delay:140ms}
  .hero-text .hero-anim:nth-child(4){animation-delay:210ms}
  .hero-text .hero-anim:nth-child(5){animation-delay:280ms}
  .hero-text .hero-anim:nth-child(6){animation-delay:340ms}
  .hero-text .hero-anim:nth-child(7){animation-delay:400ms}
  .hero-visual{animation-delay:200ms}
  @keyframes heroIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  .name-underline{position:relative;display:inline-block}
  .name-underline::after{content:"";position:absolute;left:0;right:0;bottom:0.06em;height:0.09em;background:linear-gradient(90deg,var(--accent),var(--accent-strong));background-size:200% 100%;border-radius:2px;transform-origin:left;animation:drawLine 0.6s var(--ease) 0.45s both,accentShift 6s ease-in-out 1.2s infinite alternate}
  @keyframes drawLine{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  @keyframes accentShift{from{background-position:0% 0}to{background-position:100% 0}}
  .card{transition:transform 0.3s var(--ease),box-shadow 0.3s var(--ease)}
  .visual:hover .card{transform:translateY(-3px)}
</style>
