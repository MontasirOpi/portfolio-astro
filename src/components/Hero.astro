---
import { PROFILE } from '../data/portfolio';
import Icon from './Icon.astro';
const p = PROFILE;
// Split the name so the first line is "Fahim Montasir" and the last word
// ("Opi") sits on its own line — matching the screenshot layout — while
// staying driven by PROFILE.name. The green accent bar is a separate
// element BELOW the name (see .name-rule), never an overlay on the text.
const nameWords = p.name.split(' ');
const nameLine1 = nameWords.slice(0, -1).join(' ');
const nameLine2 = nameWords.slice(-1).join(' ');
---
<section class="hero" id="top">
  <div class="container hero-grid reveal">
    <div class="hero-text">
      <p class="eyebrow hero-anim">// Hello world, I&rsquo;m<span class="caret" aria-hidden="true"></span></p>
      <h1 class="display hero-anim hero-name" aria-label={p.name}><span class="name-line">{nameLine1}</span><span class="name-line">{nameLine2}</span></h1>
      <span class="name-rule hero-anim" aria-hidden="true"></span>
      <p class="role hero-anim">Flutter Developer &middot; {p.title}</p>
      <p class="lede hero-anim">{p.heroIntro}</p>
      <div class="cta hero-anim"><a href="#projects" class="btn btn-primary">View Projects <Icon name="arrow" /></a><a href={p.cvUrl} target="_blank" rel="noopener" class="btn btn-ghost">View CV</a><a href="#contact" class="btn btn-ghost">Contact</a></div>
      <div class="socials hero-anim"><a href={p.github} target="_blank" rel="noopener" aria-label="GitHub profile"><Icon name="github" /> GitHub</a><a href={p.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile"><Icon name="linkedin" /> LinkedIn</a><span class="loc"><Icon name="pin" /> {p.location}</span></div>
      <div class="meta hero-anim"><span><strong>Focus</strong> Flutter &middot; AI-Assisted &middot; Firebase &middot; OTA</span><span><strong>Currently</strong> Associate Software Engineer</span></div>
    </div>
    <aside class="visual hero-anim hero-visual" aria-label="Profile photo">
      <div class="photo-wrap"><img src={p.profileImage} alt="Portrait of Fahim Montasir Opi" width="520" height="520" fetchpriority="high" /></div>
      <div class="card"><p class="card-label">Currently building</p><p class="card-title">Production Flutter apps</p><p class="card-sub">AI-assisted &middot; Firebase backends &middot; OTA as one specialty</p></div>
    </aside>
  </div>
</section>
<style>
  .hero{position:relative;padding-block:3rem 3.5rem;overflow:hidden}
  /* Soft ambient glow behind the hero — pure CSS gradient, no extra assets. */
  .hero::before{content:"";position:absolute;inset:-120px -80px auto auto;width:min(560px,80vw);height:min(560px,80vw);background:radial-gradient(closest-side,color-mix(in srgb,var(--accent) 14%,transparent),transparent 72%);pointer-events:none}
  @media(min-width:900px){.hero{padding-block:4.5rem 5rem}}
  .hero-grid{position:relative;display:grid;gap:2.5rem;align-items:center}
  @media(min-width:900px){.hero-grid{grid-template-columns:1.15fr 0.85fr;gap:3rem}}
  .eyebrow{display:flex;align-items:center;gap:0.15em}
  .caret{display:inline-block;width:0.55em;height:1em;margin-left:0.25em;background:var(--accent);border-radius:1px;animation:blink 1.1s steps(1) infinite}
  @keyframes blink{0%,55%{opacity:1}56%,100%{opacity:0}}
  .hero-name{margin:0}
  .name-line{display:block}
  /*
    FIX — the old underline was a ::after pseudo-element on the whole
    multi-line name (bottom:0.06em, height:0.09em). Because the span's box
    covers both lines, that bar landed inside the last line's glyph box
    and sliced straight through "Opi". The accent is now a real element
    in normal flow, below the name, with its own reserved height — it
    can never overlap text on any screen size, and causes no layout shift.
  */
  .name-rule{display:block;height:6px;width:100%;margin:0.55rem 0 0;border-radius:999px;background:linear-gradient(90deg,var(--accent),var(--accent-strong));background-size:200% 100%;box-shadow:0 0 18px color-mix(in srgb,var(--accent) 35%,transparent);transform-origin:left;animation:drawRule 0.6s var(--ease) 0.5s both,accentShift 6s ease-in-out 1.4s infinite alternate}
  @keyframes drawRule{from{transform:scaleX(0);opacity:0}to{transform:scaleX(1);opacity:1}}
  @keyframes accentShift{from{background-position:0% 0}to{background-position:100% 0}}
  .role{font-family:var(--font-display);font-size:clamp(1.2rem,2vw,1.5rem);color:var(--accent);font-weight:600;margin:0.9rem 0 1rem}
  @supports ((-webkit-background-clip:text) or (background-clip:text)){
    .role{background:linear-gradient(90deg,var(--accent),var(--accent-strong),var(--accent));background-size:200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent}
  }
  .cta{display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1.8rem}
  .btn-primary{position:relative;overflow:hidden}
  .btn-primary::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,0.35) 50%,transparent 60%);transform:translateX(-120%);transition:transform 0.6s var(--ease)}
  .btn-primary:hover::after{transform:translateX(120%)}
  .socials{display:flex;flex-wrap:wrap;gap:1.25rem;margin-top:1.6rem;font-size:0.92rem}
  .socials a{display:inline-flex;gap:0.45rem;align-items:center;text-decoration:none;font-weight:600;transition:color var(--dur) var(--ease),transform var(--dur) var(--ease)}
  .socials a:hover{color:var(--accent);text-decoration:none;transform:translateY(-1px)}
  .loc{display:inline-flex;gap:0.4rem;align-items:center;color:var(--text-2)}
  .meta{display:flex;flex-wrap:wrap;gap:1.5rem;margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--border);font-size:0.9rem;color:var(--text-2)}
  .visual{position:relative}
  .photo-wrap{border:1px solid var(--border);border-radius:16px;overflow:hidden;background:var(--surface-2);aspect-ratio:1/1;max-width:460px;margin-inline:auto;box-shadow:var(--shadow-md);animation:floatY 7s ease-in-out 1s infinite alternate;transition:box-shadow 0.3s var(--ease),border-color 0.3s var(--ease)}
  .photo-wrap img{width:100%;height:100%;object-fit:cover;display:block;transition:transform 0.5s var(--ease)}
  .visual:hover .photo-wrap{border-color:var(--accent);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 22%,transparent),var(--shadow-md)}
  .visual:hover .photo-wrap img{transform:scale(1.03)}
  @keyframes floatY{from{transform:translateY(0)}to{transform:translateY(-8px)}}
  .card{position:absolute;left:-6px;bottom:18px;background:var(--surface);border:1px solid var(--border);border-left:3px solid var(--accent);border-radius:12px;padding:1rem 1.15rem;box-shadow:var(--shadow-md);max-width:280px;animation:floatY 7s ease-in-out 2.2s infinite alternate;transition:transform 0.3s var(--ease),box-shadow 0.3s var(--ease)}
  @media(max-width:640px){.card{position:static;margin-top:1rem;max-width:none;animation:none}}
  .card-label{font-family:var(--font-mono);font-size:0.7rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-3);margin:0 0 0.3rem}
  .card-title{font-weight:700;margin:0}
  .card-sub{margin:0.25rem 0 0;color:var(--text-2);font-size:0.88rem}
  /* Staggered hero entrance — transform/opacity only, no layout shift. */
  .hero-anim{animation:heroIn 0.5s var(--ease) both}
  .hero-text .hero-anim:nth-child(1){animation-delay:0ms}
  .hero-text .hero-anim:nth-child(2){animation-delay:70ms}
  .hero-text .hero-anim:nth-child(3){animation-delay:140ms}
  .hero-text .hero-anim:nth-child(4){animation-delay:210ms}
  .hero-text .hero-anim:nth-child(5){animation-delay:280ms}
  .hero-text .hero-anim:nth-child(6){animation-delay:340ms}
  .hero-text .hero-anim:nth-child(7){animation-delay:400ms}
  .hero-text .hero-anim:nth-child(8){animation-delay:460ms}
  .hero-visual{animation-delay:200ms}
  @keyframes heroIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
  /* The name-rule has its own draw animation; keep the generic entrance off it
     so the two animations don't fight. */
  .hero-text .hero-anim.name-rule{animation:drawRule 0.6s var(--ease) 0.5s both,accentShift 6s ease-in-out 1.4s infinite alternate}
  @media (prefers-reduced-motion: reduce){
    .hero-anim,.name-rule,.caret,.photo-wrap,.card,.role{animation:none!important}
    .photo-wrap img,.btn-primary::after{transition:none!important}
    .name-rule{transform:none;opacity:1}
  }
</style>
