<style>
  .murphy-avatar{width:100%;display:block;overflow:visible;filter:drop-shadow(0 6px 8px #15372720)}
  .eyes-happy,.eyes-love,.eyes-sleep,.sparkles{display:none}
  .eye{transform-box:fill-box;transform-origin:center;animation:blink 6s infinite}
  .arm-right{transform-origin:119px 111px;animation:wave 6s ease-in-out infinite}
  .antenna{animation:glow 3s ease-in-out infinite}
  :global([data-mood="happy"]) .eyes-normal,:global([data-mood="excited"]) .eyes-normal,:global([data-mood="love"]) .eyes-normal,:global([data-mood="sleep"]) .eyes-normal,:global([data-mood="sad"]) .eyes-normal{display:none}
  :global([data-mood="happy"]) .eyes-happy,:global([data-mood="excited"]) .eyes-happy,:global([data-mood="love"]) .eyes-love,:global([data-mood="sleep"]) .eyes-sleep,:global([data-mood="sad"]) .eyes-sleep,:global([data-mood="excited"]) .sparkles{display:block}
  :global([data-mood="excited"]) .robot{animation:dance .7s ease-in-out infinite;transform-origin:80px 140px}
  :global([data-mood="sleep"]) .arm-right{animation:none}
  @keyframes blink{0%,43%,47%,100%{transform:scaleY(1)}45%{transform:scaleY(.12)}}
  @keyframes wave{0%,65%,100%{transform:rotate(0)}72%,85%{transform:rotate(15deg)}78%,91%{transform:rotate(-10deg)}}
  @keyframes glow{50%{fill:#86efac}}
  @keyframes dance{25%{transform:rotate(-5deg) translateY(-3px)}75%{transform:rotate(5deg) translateY(-3px)}}
  @media(prefers-reduced-motion:reduce){*{animation:none!important}}
</style>
