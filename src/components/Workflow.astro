---
import { WORKFLOW } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---
<section class="section" id="workflow">
  <div class="container">
    <SectionHeading eyebrow="Workflow" title="How I approach development" subtitle="Flutter + Firebase + AI, in a practical delivery loop." />
    <ol class="steps">{WORKFLOW.map((w) => <li><span class="num">{w.step}</span><h3>{w.title}</h3><p>{w.text}</p></li>)}</ol>
  </div>
</section>
<style>
  .steps{list-style:none;margin:0;padding:0;display:grid;gap:1rem}
  @media(min-width:700px){.steps{grid-template-columns:1fr 1fr}}
  @media(min-width:1100px){.steps{grid-template-columns:1fr 1fr 1fr 1fr}}
  .steps li{border:1px solid var(--border);background:var(--surface);border-radius:12px;padding:1.25rem}
  .num{font-family:var(--font-mono);color:var(--accent);font-weight:600;font-size:0.85rem}
  h3{margin:0.5rem 0 0.5rem;font-family:var(--font-display);font-size:1.02rem}
  p{margin:0;color:var(--text-2);font-size:0.93rem}
</style>
